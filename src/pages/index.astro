---
// ============================================================================
// Home page ("Quiénes Somos")
// ============================================================================
// This is the one page rebuilt in this first pass, to prove the layout,
// design tokens and shared components (Hero, ProductGrid, CTASection) all
// work together end-to-end. The remaining pages (Maxxis, Neumáticos,
// Neumáticos Agrícolas, Contacto) follow the same pattern in the next
// phase and are intentionally not built yet.
//
// All copy below is the same "Quiénes Somos" text from the current live
// index.html, pulled from src/data/site.js - nothing was rewritten or
// invented.
// ============================================================================
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CTASection from "../components/CTASection.astro";
import { site } from "../data/site.js";
import { maxxisProducts } from "../data/products.js";

const [firstParagraph, ...restParagraphs] = site.about.paragraphs;

// A small, real preview of the catalog on the homepage - not a new claim
// about the business, just a different place to show three of the same
// products already listed in full on the Maxxis page.
const featuredProducts = maxxisProducts.slice(0, 3);
---

<BaseLayout title={`${site.name} - ${site.about.heading}`} description={site.tagline}>
  <Hero
    eyebrow={site.name}
    title={site.about.heading}
    subtitle={firstParagraph}
    image="/images/workshop-hero.png"
  />

  <section class="section">
    <div class="container about-card">
      {restParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="featured-heading">Algunos de nuestros neumáticos</h2>
      <ProductGrid products={featuredProducts} />
    </div>
  </section>

  <CTASection heading="¿Tienes dudas sobre qué neumático necesitas?" text="Escríbenos y te asesoramos sin costo." />
</BaseLayout>

<style>
  .about-card {
    max-width: 720px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-muted);
  }

  .featured-heading {
    text-align: center;
    margin-bottom: var(--space-6);
  }
</style>
