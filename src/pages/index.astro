---
// ============================================================================
// Home page - the single-page site
// ============================================================================
// Composes the sections in navigation order. Each section owns its own
// markup, styles and motion; this file only decides the order.
//
// Chapters, alternating light and dark: hero (photo) -> Maxxis (red band,
// paper showroom) -> brands (black band) -> Neumáticos (white rail) ->
// Agrícolas (black, industrial) -> Nosotros (paper, editorial) ->
// Contacto (red) -> footer (black, closing wordmark).
// ============================================================================
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import MaxxisSection from "../components/sections/MaxxisSection.astro";
import TiresSection from "../components/sections/TiresSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import BrandsSection from "../components/sections/BrandsSection.astro";
import AgriculturalSection from "../components/sections/AgriculturalSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
---

<BaseLayout>
  <HeroSection />
  <MaxxisSection />
  <BrandsSection />
  <TiresSection />
  <AgriculturalSection />
  <AboutSection />
  <ContactSection />
</BaseLayout>
