---
// ============================================================================
// CTASection
// ============================================================================
// A generic "talk to us" band that can be dropped at the bottom of any
// page (home, a product category, contact...) with different text. Keeps
// every page ending on the same strong, consistent call-to-action instead
// of each page inventing its own closing section.
//
// Props:
//   heading, text   - the message
//   ctaText/ctaHref - the button (defaults to the WhatsApp link so this
//                      works out of the box with zero props on most pages)
// ============================================================================
import { site } from "../data/site.js";

interface Props {
  heading: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  heading,
  text,
  ctaText = "Escríbenos por WhatsApp",
  ctaHref = site.contact.whatsappUrl,
} = Astro.props;
---

<section class="cta section">
  <div class="container cta-inner">
    <h2>{heading}</h2>
    {text && <p>{text}</p>}
    <a class="cta-button" href={ctaHref} target="_blank" rel="noopener noreferrer">
      {ctaText}
    </a>
  </div>
</section>

<style>
  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .cta-inner p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .cta-button {
    display: inline-block;
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-6);
    background: var(--color-brand);
    color: var(--color-text-inverted);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .cta-button:hover {
    background: var(--color-brand-dark);
    transform: translateY(-2px);
  }
</style>
