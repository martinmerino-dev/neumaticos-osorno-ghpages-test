---
// ============================================================================
// ContactSection  (#contacto)
// ============================================================================
// The conversion chapter, on full brand red. One obvious next step
// (WhatsApp - the business's main channel) and every other tappable
// channel. No contact form: the owner chose not to offer an email-submit
// path here - the email address itself is still shown, but only in the
// footer (see Footer.astro), not as an entry point up here.
//
// Contact details, address and hours are the ones CONFIRMED by the business
// (src/data/site.js) and match the LocalBusiness structured data.
//
// "Visítanos" row: an interactive Google Maps iframe + directions links.
//   - With PUBLIC_GOOGLE_MAPS_EMBED_KEY set, the map uses the official Maps
//     Embed API (restrict that key to this domain + the Embed API in Google
//     Cloud). Without it, Google's keyless embed URL is used.
//   - No coordinates are hard-coded: Google resolves the address.
//   - loading="lazy": the map never blocks the initial render.
// ============================================================================
import SplitWords from "../SplitWords.astro";
import { site, whatsappMessageUrl, fullAddress, mapsLinks } from "../../data/site.js";

const maps = mapsLinks();
const embedKey = import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_KEY;
const mapSrc = embedKey
  ? `https://www.google.com/maps/embed/v1/place?key=${encodeURIComponent(embedKey)}&q=${encodeURIComponent(fullAddress())}&zoom=16&language=es&region=CL`
  : maps.embed;

const telHref = (phone: string) => `tel:${phone.replace(/\s/g, "")}`;

const channels = [
  { label: "WhatsApp", value: site.contact.whatsappPhone, href: whatsappMessageUrl("Hola, quiero hacer una consulta."), external: true },
  ...site.contact.phones.map((phone) => ({ label: "Teléfono", value: phone, href: telHref(phone), external: false })),
];
---

<section id="contacto" class="contact" aria-labelledby="contacto-title">
  <div class="container">
    <div class="contact-intro">
      <h2 id="contacto-title" class="contact-title" data-reveal-words>
        <SplitWords text="Contacto" />
      </h2>
      <p class="contact-lead" data-reveal>¿Tienes dudas sobre qué neumático necesitas?</p>

      <div class="contact-primary" data-reveal>
        <a
          class="button button--black contact-whatsapp"
          href={site.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src="/icons/whatsapp.svg" alt="" width="22" height="22" />
          Escríbenos por WhatsApp
          <span class="sr-only"> (abre en una nueva pestaña)</span>
        </a>
        <p class="contact-shipping">{site.shipping.message}</p>
      </div>

      <ul class="channels" data-reveal-group>
        {
          channels.map((channel) => (
            <li>
              <a
                class="channel"
                href={channel.href}
                target={channel.external ? "_blank" : undefined}
                rel={channel.external ? "noopener noreferrer" : undefined}
              >
                <span class="channel-label">{channel.label}</span>
                <span class="channel-value">{channel.value}</span>
                {channel.external && <span class="sr-only"> (abre en una nueva pestaña)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container visit">
    <div class="visit-map" data-reveal-mask>
      <iframe
        src={mapSrc}
        title={`Mapa de Google: ${site.name}, ${fullAddress()}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>

    <div class="visit-info" data-reveal-group>
      <h3 class="visit-title">Visítanos</h3>

      <address class="visit-address">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.locality}, {site.address.region}
      </address>

      <dl class="visit-hours">
        {
          site.hours.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>
                {h.opens}–{h.closes}
              </dd>
            </div>
          ))
        }
        <div>
          <dt>{site.closedLabel.split(":")[0]}</dt>
          <dd>{site.closedLabel.split(":")[1].trim()}</dd>
        </div>
      </dl>

      <div class="visit-actions">
        <a
          class="button button--black"
          href={maps.directions}
          target="_blank"
          rel="noopener noreferrer"
          data-track="directions_click"
          data-track-map-action="directions"
        >
          Cómo llegar<span class="sr-only"> (abre Google Maps en una nueva pestaña)</span>
        </a>
        <a
          class="visit-link"
          href={maps.view}
          target="_blank"
          rel="noopener noreferrer"
          data-track="directions_click"
          data-track-map-action="view_map"
        >
          Ver en Google Maps<span class="sr-only"> (abre en una nueva pestaña)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    background: var(--color-brand);
    color: var(--color-text-inverted);
    padding-block: var(--space-9);
  }

  .contact-intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    max-width: 44rem;
  }

  /* Black on red passes contrast only at display sizes - this is one. */
  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, min(1rem + 15vw, 20svh), 13rem);
    font-weight: var(--font-weight-black);
    font-stretch: var(--font-stretch-condensed);
    line-height: 0.85;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-black);
  }

  .contact-lead {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    font-weight: var(--font-weight-bold);
    font-stretch: var(--font-stretch-semi);
    line-height: 1.05;
  }

  .contact-primary {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-3);
  }

  .contact-whatsapp {
    min-height: 64px;
    padding-inline: var(--space-7);
    font-size: 1.0625rem;
  }

  .contact-whatsapp img {
    filter: brightness(0) invert(1);
    transition: filter var(--transition-base);
  }

  .contact-whatsapp:hover img,
  .contact-whatsapp:focus-visible img {
    filter: brightness(0);
  }

  .contact-shipping {
    font-weight: var(--font-weight-semibold);
    font-stretch: var(--font-stretch-expanded);
    font-size: var(--font-size-sm);
  }

  /* ---- Channels -------------------------------------------------------- */

  .channels {
    list-style: none;
    margin-top: var(--space-5);
    border-top: 2px solid var(--color-black);
  }

  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    min-height: 56px;
    padding-block: var(--space-4);
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
  }

  .channel-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    font-stretch: var(--font-stretch-expanded);
  }

  .channel-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: var(--font-weight-black);
    font-stretch: var(--font-stretch-condensed);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .channel:hover .channel-value,
  .channel:focus-visible .channel-value {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  /* Focus ring must read on red: black instead of the red default. */
  .contact :focus-visible {
    outline-color: var(--color-black);
  }

  /* ---- Visítanos: map + address + hours ------------------------------ */

  .visit {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 2px solid var(--color-black);
  }

  /* Black frame so the map reads as part of the red/black chapter. */
  .visit-map {
    position: relative;
    height: clamp(280px, 55vw, 440px);
    border: 4px solid var(--color-black);
    background: var(--color-black);
  }

  /* The map iframe is a keyboard stop: show the ring on its frame. */
  .visit-map:focus-within {
    outline: 3px solid var(--color-black);
    outline-offset: 4px;
  }

  .visit-map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .visit-info {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .visit-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    font-weight: var(--font-weight-black);
    font-stretch: var(--font-stretch-condensed);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-black);
  }

  .visit-address {
    font-style: normal;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: var(--font-weight-black);
    font-stretch: var(--font-stretch-condensed);
    line-height: 1.05;
  }

  .visit-hours {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(0, 0, 0, 0.25);
  }

  .visit-hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .visit-hours dt {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    font-stretch: var(--font-stretch-expanded);
  }

  .visit-hours dd {
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .visit-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: var(--font-weight-bold);
    font-stretch: var(--font-stretch-expanded);
    text-decoration: underline;
    text-decoration-color: var(--color-black);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .visit-link:hover,
  .visit-link:focus-visible {
    text-decoration-thickness: 4px;
  }

  @media (min-width: 1024px) {
    .visit {
      grid-template-columns: 7fr 5fr;
      align-items: stretch;
      column-gap: var(--space-8);
    }

    .visit-map {
      height: auto;
      min-height: 420px;
    }
  }

  @media (max-width: 599px) {
    .visit-actions .button {
      width: 100%;
    }

    .contact-primary,
    .contact-whatsapp {
      width: 100%;
    }
  }
</style>
