---
// ============================================================================
// FreeShippingBanner
// ============================================================================
// The small pill announcement under the navbar ("Despacho gratuito").
// A tiny component, but broken out on its own because it's reused
// unchanged on every page - if that message or offer ever changes, it
// changes in one place.
// ============================================================================
import { site } from "../data/site.js";
---

<div class="shipping-banner">
  <p>{site.shipping.message}</p>
</div>

<style>
  .shipping-banner {
    background: linear-gradient(135deg, var(--color-brand) 0%, #ff7a2e 100%);
    color: var(--color-text-inverted);
    text-align: center;
    font-weight: var(--font-weight-semibold);
    padding: var(--space-3) var(--space-6);
    max-width: 360px;
    margin: var(--space-5) auto;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
  }
</style>
