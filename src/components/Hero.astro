---
// ============================================================================
// Hero
// ============================================================================
// The page-opening section: eyebrow label, a headline that reveals
// word-by-word on load (see src/scripts/heroIntro.js), supporting text,
// up to two call-to-action buttons, and an optional photo.
//
// The headline is split into words at build time (in this frontmatter,
// not in the browser) so the full text is present in the HTML from the
// very first paint - a screen reader or a visitor with JS disabled reads
// the complete headline immediately. JS only adds the reveal animation
// on top of already-correct, already-accessible markup.
//
// Props:
//   eyebrow            - small label above the headline
//   title              - the page's <h1>, animates in word-by-word
//   subtitle           - one or two supporting sentences
//   image              - optional photo shown beside the text
//   primaryCta/secondaryCta - optional { text, href } buttons
// ============================================================================
interface CTA {
  text: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
}

const { eyebrow, title, subtitle, image, primaryCta, secondaryCta } = Astro.props;
const words = title.split(" ");
---

<section class="hero" data-hero>
  <div class="container hero-inner" class:list={{ "has-image": Boolean(image) }}>
    <div class="hero-copy">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}

      <h1 class="hero-title">
        {
          words.map((word, i) => (
            <span class="word">
              <span class="word-inner">
                {word}
                {i < words.length - 1 ? " " : ""}
              </span>
            </span>
          ))
        }
      </h1>

      {subtitle && <p class="hero-subtitle">{subtitle}</p>}

      {
        (primaryCta || secondaryCta) && (
          <div class="hero-actions">
            {primaryCta && (
              <a class="btn btn-primary" href={primaryCta.href}>
                {primaryCta.text}
              </a>
            )}
            {secondaryCta && (
              <a
                class="btn btn-secondary"
                href={secondaryCta.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {secondaryCta.text}
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      image && (
        <div class="hero-media">
          <img src={image} alt="" width="640" height="480" />
        </div>
      )
    }
  </div>
</section>

<script>
  import { initHeroIntro } from "../scripts/heroIntro.js";
  initHeroIntro();
</script>

<style>
  .hero {
    background: var(--color-bg-inverted);
    color: var(--color-text-inverted);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-9);
    align-items: center;
  }

  .hero-inner.has-image {
    grid-template-columns: 1.1fr 1fr;
  }

  .hero-eyebrow {
    color: var(--color-brand);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-3);
  }

  .hero-title {
    color: var(--color-text-inverted);
  }

  /* Each word sits inside an overflow-hidden mask; heroIntro.js slides
     .word-inner up from below the mask, so the word appears to rise into
     place rather than simply fading. */
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .word-inner {
    display: inline-block;
  }

  .hero-subtitle {
    margin-top: var(--space-4);
    max-width: 48ch;
    color: var(--color-mist);
    font-size: var(--font-size-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base), transform var(--transition-base),
      border-color var(--transition-base);
  }

  .btn-primary {
    background: var(--color-brand);
    color: var(--color-text-inverted);
  }

  .btn-primary:hover {
    background: var(--color-brand-dark);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text-inverted);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    border-color: var(--color-text-inverted);
    transform: translateY(-2px);
  }

  .hero-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 900px) {
    .hero-inner.has-image {
      grid-template-columns: 1fr;
    }

    .hero-media {
      order: -1;
    }
  }

  /* On short mobile viewports, a full-size hero photo + heading + two
     buttons is taller than the screen, which pushes the heading down
     into the same bottom-right corner the floating WhatsApp button
     occupies. Compacting the rhythm here keeps the whole hero clear of
     that corner. */
  @media (max-width: 600px) {
    .hero-inner {
      padding-block: var(--space-7);
      gap: var(--space-4);
    }

    .hero-media img {
      max-height: 200px;
      object-fit: cover;
    }

    .hero-actions {
      margin-top: var(--space-4);
    }
  }
</style>
