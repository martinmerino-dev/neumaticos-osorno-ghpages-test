---
// ============================================================================
// CategoryGrid
// ============================================================================
// Lays out CategoryCard components in a responsive grid. Mirrors the
// ProductGrid/ProductCard split so both "grid of X" patterns in the
// codebase work the same way.
// ============================================================================
import CategoryCard from "./CategoryCard.astro";

interface Category {
  title: string;
  subtitle?: string;
  href: string;
  image?: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<div class="category-grid" data-reveal-group>
  {categories.map((category) => <CategoryCard {...category} />)}
</div>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
</style>
