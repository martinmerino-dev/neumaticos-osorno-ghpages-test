---
// ============================================================================
// ProductGrid
// ============================================================================
// Lays out a list of products as a responsive grid of ProductCard
// components. This is the piece that replaces the old hand-written
// "<div class="product-grid"> ... 6 copy-pasted cards ..." block on
// maxxis.html / neumaticos.html.
//
// Usage:  <ProductGrid products={maxxisProducts} />
// ============================================================================
import ProductCard from "./ProductCard.astro";

interface Product {
  slug: string;
  name: string;
  type: string;
  usage: string;
  features: string[];
  image: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="product-grid">
  {products.map((product, index) => <ProductCard product={product} index={index} />)}
</div>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
</style>
