---
// ============================================================================
// CategoryCard
// ============================================================================
// One large, clickable card representing a real product category/page
// (Maxxis, Neumáticos, Neumáticos Agrícolas). If an `image` is given it's
// shown as a full-bleed photo behind the title with a scale-on-hover
// micro-interaction; without one, the card falls back to a bold
// typographic treatment on a gradient - still premium, no invented photo
// standing in for a category we don't have real photography for yet.
//
// Props: title, subtitle (should be a real, derived fact - see
// index.astro), href, image (optional).
// ============================================================================
interface Props {
  title: string;
  subtitle?: string;
  href: string;
  image?: string;
}

const { title, subtitle, href, image } = Astro.props;
---

<a class="category-card" class:list={{ "has-image": Boolean(image) }} href={href}>
  {image && <img src={image} alt="" loading="lazy" width="480" height="360" />}
  <div class="category-copy">
    <h3>{title}</h3>
    {subtitle && <p>{subtitle}</p>}
    <span class="category-link">Ver más →</span>
  </div>
</a>

<style>
  .category-card {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 320px;
    background: linear-gradient(160deg, var(--color-charcoal), var(--color-ink));
    color: var(--color-text-inverted);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .category-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .category-card.has-image:hover img {
    transform: scale(1.06);
  }

  .category-card.has-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15, 16, 19, 0.92) 0%, rgba(15, 16, 19, 0.15) 65%);
  }

  .category-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: var(--space-6);
  }

  .category-copy h3 {
    color: var(--color-text-inverted);
    font-size: var(--font-size-2xl);
  }

  .category-copy p {
    margin-top: var(--space-2);
    color: var(--color-mist);
  }

  .category-link {
    margin-top: var(--space-4);
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand);
  }
</style>
