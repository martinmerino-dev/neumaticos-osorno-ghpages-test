# Copy to .env (never commit .env) or set these in the build environment
# (e.g. GitHub Actions secrets/variables) before `npm run build`.

# Google Analytics 4 Measurement ID of the web data stream (format G-XXXXXXXXXX).
# Analytics > Admin > Data streams > (web stream) > Measurement ID.
# Leave empty to build with analytics completely disabled.
PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Maps Embed API key for the Contacto map (official Embed API).
# Restrict it in Google Cloud to HTTP referrer neumaticososorno.cl/* and to the
# "Maps Embed API" only. Leave empty to use Google's keyless embed URL.
PUBLIC_GOOGLE_MAPS_EMBED_KEY=
